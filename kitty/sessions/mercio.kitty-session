# Mercio workspace: every window runs inside the repo's nix dev shell (flake.nix) via mercio-pane.
# Open with: kitty --session ~/.config/kitty/sessions/mercio.kitty-session

cd /Users/miguel/Projects/mercio/mercio

new_tab dev
layout splits
launch --title nvim /Users/miguel/.config/kitty/sessions/mercio-pane nvim
# Opens on this tab, with nvim focused.
focus
launch --location=vsplit --title claude /Users/miguel/.config/kitty/sessions/mercio-pane claude --resume

new_tab shell
launch --title shell /Users/miguel/.config/kitty/sessions/mercio-pane

# Docker on the left (Postgres, Keycloak, Liquibase); the two Spring apps stacked on the right.
new_tab infra
layout splits
launch --title docker /Users/miguel/.config/kitty/sessions/mercio-pane 'colima status >/dev/null 2>&1 || colima start; yarn db-start && docker-compose -f apps/docker-compose.yaml logs -f'
# Waits for the Liquibase migrations to finish before booting.
launch --location=vsplit --title pricing-lab /Users/miguel/.config/kitty/sessions/mercio-pane 'echo "Waiting for Liquibase..."; until [ -n "$(docker-compose -f apps/docker-compose.yaml ps -a -q --status exited liquibase 2>/dev/null)" ]; do sleep 3; done; ./gradlew apps:pricing-lab:bootRun --args=--spring.profiles.active=postgres'
# Waits for pricing-lab (:4000) so the two Gradle builds don't compile the shared modules at once.
launch --location=hsplit --title headless-bi /Users/miguel/.config/kitty/sessions/mercio-pane 'echo "Waiting for pricing-lab on :4000..."; until nc -z localhost 4000 2>/dev/null; do sleep 3; done; ./gradlew apps:headless-bi:bootRun --args=--spring.profiles.active=postgres'

new_tab frontend
launch --title front /Users/miguel/.config/kitty/sessions/mercio-pane 'yarn install && yarn dev'
