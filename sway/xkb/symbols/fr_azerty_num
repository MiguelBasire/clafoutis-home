// French AZERTY with an unshifted number row.
//
// Self-contained: this is the full fr(azerty) definition inlined, with
// levels 1 and 2 of AE01..AE10 swapped so digits are typed directly and
// & é " ' ( - è _ ç à move to Shift. Level 3 (AltGr) is untouched, so
// ~ # { [ | ` \ ^ @ stay where they are.
//
// Deliberately does NOT `include "fr(azerty)"` — only level3(ralt_switch),
// which is the same include us_qwerty-fr uses and is known to resolve here.

partial alphanumeric_keys
xkb_symbols "fr_azerty_num"
{
    name[Group1]="French (AZERTY, digits unshifted)";

    // Number row: digits at level 1, AZERTY symbols moved to Shift.
    key <TLDE> {[	twosuperior					]};
    key <AE01> {[	1,		ampersand			]};
    key <AE02> {[	2,		eacute,		asciitilde	]};
    key <AE03> {[	3,		quotedbl,	numbersign	]};
    key <AE04> {[	4,		apostrophe,	braceleft	]};
    key <AE05> {[	5,		parenleft,	bracketleft	]};
    key <AE06> {[	6,		minus,		bar		]};
    key <AE07> {[	7,		egrave,		grave		]};
    key <AE08> {[	8,		underscore,	backslash	]};
    key <AE09> {[	9,		ccedilla,	asciicircum	]};
    key <AE10> {[	0,		agrave,		at		]};
    key <AE11> {[	parenright,	degree,		bracketright	]};
    key <AE12> {[	equal,		plus,		braceright	]};

    // Everything below is stock fr(azerty), unmodified.
    key <AD01> {[	a,		A				]};
    key <AD02> {[	z,		Z				]};
    key <AD03> {[	e,		E,		EuroSign	]};
    key <AD04> {[	r,		R				]};
    key <AD05> {[	t,		T				]};
    key <AD06> {[	y,		Y				]};
    key <AD07> {[	u,		U				]};
    key <AD08> {[	i,		I				]};
    key <AD09> {[	o,		O				]};
    key <AD10> {[	p,		P				]};
    key <AD11> {[	dead_circumflex,dead_diaeresis			]};
    key <AD12> {[	dollar,		sterling,	currency	]};

    key <AC01> {[	q,		Q				]};
    key <AC02> {[	s,		S				]};
    key <AC03> {[	d,		D				]};
    key <AC04> {[	f,		F				]};
    key <AC05> {[	g,		G				]};
    key <AC06> {[	h,		H				]};
    key <AC07> {[	j,		J				]};
    key <AC08> {[	k,		K				]};
    key <AC09> {[	l,		L				]};
    key <AC10> {[	m,		M				]};
    key <AC11> {[	ugrave,		percent				]};
    key <BKSL> {[	asterisk,	mu				]};

    key <LSGT> {[	less,		greater				]};
    key <AB01> {[	w,		W				]};
    key <AB02> {[	x,		X				]};
    key <AB03> {[	c,		C				]};
    key <AB04> {[	v,		V				]};
    key <AB05> {[	b,		B				]};
    key <AB06> {[	n,		N				]};
    key <AB07> {[	comma,		question			]};
    key <AB08> {[	semicolon,	period				]};
    key <AB09> {[	colon,		slash				]};
    key <AB10> {[	exclam,		section				]};

    include "level3(ralt_switch)"
};
